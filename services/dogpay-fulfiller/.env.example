# Listening address of the fulfiller. Keep it on a private network; only ez-ai calls it.
PORT=3100
HOST=127.0.0.1

# Shared secret (at least 32 characters). Must equal the shared secret saved in
# ez-ai under System Settings > Billing > Product Fulfillment.
FULFILLER_SECRET=

# The plans, the DogPay card and the billing address are set in ez-ai, stored
# there encrypted, and sent with each job encrypted with FULFILLER_SECRET.

# Purchases run in BitBrowser (比特浏览器). It must run and be signed in on this
# machine; its Local API address is under BitBrowser settings > Local API.
# Each purchase creates a temporary window there and deletes it afterwards.
# A proxy for the windows is set in ez-ai's fulfillment settings, not here.
BITBROWSER_URL=http://127.0.0.1:54345


# Set HEADLESS=false to watch a purchase in the BitBrowser window while debugging,
# or to complete a security check by hand.
HEADLESS=true
