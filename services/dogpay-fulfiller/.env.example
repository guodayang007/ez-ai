# Listening address of the fulfiller. Keep it on a private network; only ez-ai calls it.
PORT=3100
HOST=127.0.0.1

# Shared secret (at least 32 characters). Must equal the shared secret saved in
# ez-ai under System Settings > Billing > Product Fulfillment.
FULFILLER_SECRET=

# The plans, the DogPay card and the billing address are set in ez-ai, stored
# there encrypted, and sent with each job encrypted with FULFILLER_SECRET.

# Browser option. Set HEADLESS=false to watch a purchase while debugging.
HEADLESS=true
