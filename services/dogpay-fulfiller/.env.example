# Listening address of the fulfiller. Keep it on a private network; only ez-ai calls it.
PORT=3100
HOST=127.0.0.1

# Shared with ez-ai's PRODUCT_FULFILLER_SECRET (at least 32 characters).
FULFILLER_SECRET=

# Plan codes this service may buy, comma separated. ez-ai offers exactly
# these on "Execute payment"; anything else is refused.
ALLOWED_PLANS=chatgptplusplan

# DogPay virtual card used to pay. Keep this file readable only by the service user.
DOGPAY_CARD_NUMBER=
DOGPAY_CARD_EXPIRY=MM/YY
DOGPAY_CARD_CVC=
DOGPAY_CARDHOLDER_NAME=

# Billing address registered on the DogPay card.
BILLING_COUNTRY=US
BILLING_CURRENCY=USD
BILLING_ADDRESS_LINE1=
BILLING_CITY=
BILLING_STATE=
BILLING_POSTAL_CODE=

# Browser options. Set HEADLESS=false to watch a purchase while debugging.
HEADLESS=true
# Optional proxy for the browser, e.g. http://user:pass@host:port
BROWSER_PROXY=
